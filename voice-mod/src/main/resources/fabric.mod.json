  "authors": ["Svahnen"],
  "license": "Apache-2.0",
  "environment": "server",
  "entrypoints": {
    "main": ["wren.wrenvoice.WrenVoiceMod"],
    "voicechat": ["wren.wrenvoice.WrenVoicePlugin"]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "1.21.1",
    "java": ">=21",
    "fabric-api": "*",
    "voicechat": "*"
  }
}

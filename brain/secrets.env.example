# Copy to brain/secrets.env (gitignored, chmod 600). Never commit the real file.
# Key for the S2 endpoint. Leave empty / omit if your server needs no key.
S2_API_KEY=
# Shared secret for the brain HTTP API. run.sh / supervise.sh / server.js generate one here on first run (mode 600); the bot reads it from the same file.
BRAIN_TOKEN=

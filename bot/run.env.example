# Copy to bot/run.env (gitignored). Sourced by bot/src/mindlink/supervise-mind.sh. KEY=VALUE lines only, no secrets.
# Connection to your Minecraft server (see server/README.md):
MC_HOST=127.0.0.1
MC_PORT=25566
BOT_NAME=Wren
# Autonomy of the planner: high (default) or classic (stricter validator, fewer survival-judgement warnings)
WREN_AUTONOMY=high
# Learned habit scorer: off (default) | shadow | blend. Needs a model file you trained yourself (WREN_SCORER_MODEL).
WREN_SCORER=off
# Label for this run in logs and reports
WREN_RUN_ID=my-first-run
# How chat is handled: see bot/src/mindlink/chatchan.js
MINDLINK_CHAT=fallback

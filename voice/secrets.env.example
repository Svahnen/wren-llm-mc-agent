# Copy to voice/secrets.env (gitignored, chmod 600). Never commit the real file.
# Generate each value with:  openssl rand -hex 24
# Shared token for the voice service HTTP API (header x-voice-token). Empty = no auth (API is loopback-only with a Host check).
VOICE_TOKEN=
# Must equal "secret" in the wrenvoice mod config (server/data/config/wrenvoice.json); sent as header X-Wren-Secret on the mod WebSocket.
WRENVOICE_SECRET=
# Must equal COMPANION_API_KEY of the speech servers (voice/box); sent as X-API-Key to TTS, STT and second-pass STT. Empty = servers without auth.
COMPANION_API_KEY=
